 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Download now",
   "description": "Total download of the selected devices, 3-minute rate. Follows the Zone / Device / In hosts.conf filters at the top.",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 4,
    "w": 5,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum(rate(lan_device_download_bytes_total{tracked!=\"n/a\", zone=~\"$zone\", name=~\"$device\", tracked=~\"$tracked\"}[3m])) * 8 or vector(0)",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "decimals": 1,
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
