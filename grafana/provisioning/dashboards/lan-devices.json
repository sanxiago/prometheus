  {
   "id": 6,
   "type": "timeseries",
   "title": "Download by device",
   "description": "Bytes the router sent to each device.\n\nEach colour is one device, stacked, so the top of the stack is the total for the selection; the dashed **Total** line is the same sum. Counted per MAC on `lan` by the nft `acct_lan` table (IPv4 + IPv6, includes traffic to the router itself and between zones). Click a legend entry to show only that device, Ctrl/Cmd-click to add more. Follows the Zone / Device / In hosts.conf filters at the top.",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 11,
    "w": 24,
    "x": 0,
    "y": 4
   },
   "interval": "1m",
   "targets": [
    {
     "expr": "sum by (name, mac) (rate(lan_device_download_bytes_total{tracked!=\"n/a\", zone=~\"$zone\", name=~\"$device\", tracked=~\"$tracked\"}[3m])) * 8",
     "legendFormat": "{{name}}",
     "refId": "A"
    },
    {
     "expr": "sum(rate(lan_device_download_bytes_total{tracked!=\"n/a\", zone=~\"$zone\", name=~\"$device\", tracked=~\"$tracked\"}[3m])) * 8",
     "legendFormat": "Total",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "min": 0,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 70,
      "gradientMode": "none",
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Total"
      },
      "properties": [
       {
        "id": "custom.stacking",
        "value": {
         "mode": "none",
         "group": "A"
        }
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       },
       {
        "id": "custom.lineWidth",
        "value": 2
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "text"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "showLegend": true,
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ],
     "sortBy": "Mean",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
