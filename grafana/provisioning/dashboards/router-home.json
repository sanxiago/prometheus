       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "decimals": 0,
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "NOT COUNTING",
         "index": 0
        },
        "1": {
         "text": "OK",
         "index": 1
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
