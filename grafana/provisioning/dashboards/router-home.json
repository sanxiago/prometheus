  {
   "id": 6,
   "type": "stat",
   "title": "Conntrack used",
   "description": "Share of the connection-tracking table in use. New connections are dropped when it is full.",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 15,
    "y": 0
   },
   "targets": [
    {
     "expr": "node_nf_conntrack_entries / node_nf_conntrack_entries_limit",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#EAB839",
        "value": 0.7
       },
       {
        "color": "red",
        "value": 0.9
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
