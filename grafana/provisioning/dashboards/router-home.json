  {
   "id": 6,
   "type": "stat",
   "title": "Conntrack used",
   "description": "Share of the connection-tracking table in use. New connections are dropped when it is full.",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 15,
    "y": 0
   },
   "targets": [
    {
     "expr": "node_nf_conntrack_entries / node_nf_conntrack_entries_limit",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#EAB839",
        "value": 0.7
       },
       {
        "color": "red",
        "value": 0.9
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto"
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Internet latency",
   "description": "Smokeping median round-trip to Cloudflare DNS (1.1.1.1). Normally ~7 ms on GFiber.",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 18,
    "y": 0
   },
   "targets": [
    {
     "expr": "smokeping_median_seconds{target=\"DNS/CloudflareDNS1\"}",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#EAB839",
        "value": 0.03
       },
       {
        "color": "red",
        "value": 0.1
       }
      ]
     },
     "decimals": 1,
     "links": [
      {
       "title": "Smokeping Latency & Loss",
       "url": "/d/smokeping-latency-loss"
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto"
   }
  },
  {
   "id": 8,
   "type": "stat",
   "title": "Alerts firing",
   "description": "Prometheus alerts currently firing (Alertmanager emails them).",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 21,
    "y": 0
   },
   "targets": [
    {
     "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
