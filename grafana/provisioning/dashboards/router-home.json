  {
   "id": 19,
   "type": "stat",
   "title": "Device accounting",
   "description": "Whether the per-device counters are working: the nft `acct_lan` table is loaded and its minute-by-minute dump is fresh. It isn't loaded at boot yet; after a reboot run `sudo nft -f /root/router/lan_acct_exporter/acct_lan.nft`.",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 38
   },
   "targets": [
    {
     "expr": "min(lan_acct_table_loaded * (lan_acct_dump_age_seconds < bool 180)) or vector(0)",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
