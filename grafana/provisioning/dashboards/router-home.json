      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "decimals": 0,
     "links": [
      {
       "title": "Alertmanager",
       "url": "http://192.168.2.254:9093"
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto"
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Internet traffic",
   "description": "Throughput on `wan`: **download above zero, upload below**. Each point is the peak 30-second rate in that step, so speed tests show at their real height at any zoom. Details: Router Network Activity.",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "targets": [
    {
     "expr": "max_over_time((rate(node_network_receive_bytes_total{device=\"wan\"}[30s]) * 8)[$__interval:15s])",
     "legendFormat": "download",
     "refId": "A"
    },
    {
     "expr": "max_over_time((rate(node_network_transmit_bytes_total{device=\"wan\"}[30s]) * 8)[$__interval:15s])",
     "legendFormat": "upload",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "upload"
      },
      "properties": [
       {
        "id": "custom.transform",
        "value": "negative-Y"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "download"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "upload"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "interval": "15s"
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "QoS: CAKE drops/min",
   "description": "Packets CAKE dropped to keep latency low. `wan` = uploads (900 Mbit/s cap), `lan` = downloads to clients (930 Mbit/s cap). Bursts during big transfers are normal; drops while idle mean the cap is too low.",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 12,
    "y": 4
   },
   "targets": [
    {
     "expr": "sum by (device) (rate(node_qdisc_drops_total{device=~\"wan|lan\"}[$__rate_interval])) * 60",
     "legendFormat": "{{device}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "QoS: CAKE queue",
   "description": "Bytes waiting in CAKE's queue. CAKE aims for ~5 ms of queue (~560 KB at 900 Mbit/s); a backlog that stays high means latency is building.",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 18,
    "y": 4
   },
   "targets": [
    {
     "expr": "sum by (device) (node_qdisc_backlog{device=~\"wan|lan\"})",
     "legendFormat": "{{device}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Zone traffic",
   "description": "Traffic per zone on `lan`: **download above zero, upload below**. IPv4 and IPv6. Counted per device (MAC) by the nft `acct_lan` table and summed by the device's zone from dnsmasq (`hosts.conf`; devices not listed there get the zone of their DHCP lease, or `unknown`).\n\nIncludes traffic to the router itself (DNS, self-hosted apps) and between zones, not only internet. Scraped every 60s, so 3-minute rate.",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 12
   },
   "targets": [
    {
     "expr": "sum by (zone) (rate(lan_device_download_bytes_total{tracked!=\"n/a\"}[3m])) * 8",
     "legendFormat": "{{zone}} down",
     "refId": "A"
    },
    {
     "expr": "sum by (zone) (rate(lan_device_upload_bytes_total{tracked!=\"n/a\"}[3m])) * 8",
     "legendFormat": "{{zone}} up",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".* up"
      },
      "properties": [
       {
        "id": "custom.transform",
        "value": "negative-Y"
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "green .*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "kids .*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "smarthome .*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "purple"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "guest .*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "gfiber .*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#C0C0C0"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "unknown .*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#8F8F8F"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Zone new connections/s",
   "description": "New outbound connections per zone (NAT `MASQUERADE` only sees the first packet of each connection). A good measure of how busy a zone is regardless of bandwidth.\n\nIPv4 only; IPv6 traffic isn't counted per zone. `guest` (.5) has no counters. From the iptables exporter (scraped every 60s, so 3-minute rate).",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 12,
    "y": 12
   },
   "targets": [
    {
     "expr": "sum(rate(iptables_packets{table=\"nat\",chain=\"POSTROUTING\",destination=\"MASQUERADE\",rule=~\"-s_192\\\\.168\\\\.2\\\\.0/24_.*\"}[3m]))",
     "legendFormat": "green",
     "refId": "A"
    },
    {
     "expr": "sum(rate(iptables_packets{table=\"nat\",chain=\"POSTROUTING\",destination=\"MASQUERADE\",rule=~\"-s_192\\\\.168\\\\.3\\\\.0/24_.*\"}[3m]))",
     "legendFormat": "kids",
     "refId": "B"
    },
    {
     "expr": "sum(rate(iptables_packets{table=\"nat\",chain=\"POSTROUTING\",destination=\"MASQUERADE\",rule=~\"-s_192\\\\.168\\\\.4\\\\.0/24_.*\"}[3m]))",
     "legendFormat": "smarthome",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "green"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "kids"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
