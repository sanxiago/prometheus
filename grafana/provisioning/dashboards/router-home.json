 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Uptime",
   "description": "Time since the router last booted.",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "expr": "time() - node_boot_time_seconds",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Load (1m)",
   "description": "1-minute load average. The router has 4 cores: under 2 is relaxed, 3.5+ for 10 minutes fires the `high_load` alert.",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 3,
    "y": 0
   },
   "targets": [
    {
     "expr": "node_load1",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#EAB839",
        "value": 2
       },
       {
        "color": "red",
        "value": 3.5
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Memory used",
   "description": "RAM in use, excluding reclaimable cache (1 - MemAvailable/MemTotal).",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 6,
    "y": 0
   },
   "targets": [
    {
     "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#EAB839",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.9
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto"
   }
  },
  {
