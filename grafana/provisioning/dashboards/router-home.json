   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "CPU temp",
   "description": "CPU package temperature (`x86_pkg_temp`).",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "expr": "node_thermal_zone_temp{type=\"x86_pkg_temp\"}",
